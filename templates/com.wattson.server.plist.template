<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.wattson.server</string>
  <key>ProgramArguments</key><array>
    <string>@@BIN@@/wattson-server</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>WATTSON_CONFIG</key><string>@@ROOT@@/agg.config.json</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>@@HOME@@/wattson/server.log</string>
  <key>StandardErrorPath</key><string>@@HOME@@/wattson/server.log</string>
</dict></plist>
